# Copy to .env (git-ignored) for docker compose. See "Authentication" in README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32
SESSION_SECRET=
# Encrypts the stored Azure DevOps PATs (Fernet key):
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAT_ENCRYPTION_KEY=
# Optional, comma-separated, e.g. criticalmanufacturing.com
AUTH_ALLOWED_EMAIL_DOMAINS=
# Set to false only for local development without Google
AUTH_ENABLED=true
